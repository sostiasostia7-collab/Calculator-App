<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple HTML Calculator</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #f4f4f9;
            margin: 0;
        }
        .calculator {
            width: 280px;
            height: 380px;
            background-color: #333;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
        }
        .screen {
            width: 100%;
            height: 50px;
            background-color: #fff;
            font-size: 2rem;
            text-align: right;
            padding: 5px;
            box-sizing: border-box;
            border: none;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        .keys {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        button {
            height: 50px;
            font-size: 1.2rem;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background-color: #e0e0e0;
            transition: background 0.2s;
        }
        button:active {
            background-color: #bbb;
        }
        .operator {
            background-color: #ff9f0a;
            color: white;
        }
        .operator:active {
            background-color: #cc7f08;
        }
        .clear {
            background-color: #af2929;
            color: white;
            grid-column: span 2;
        }
        .clear:active {
            background-color: #872020;
        }
        .equal {
            grid-column: span 2;
            background-color: #258525;
            color: white;
        }
        .equal:active {
            background-color: #1a5c1a;
        }
    </style>
</head>
<body>

<div class="calculator">
    <input type="text" class="screen" id="result" readonly value="0">
    <div class="keys">
        <button class="clear" onclick="clearScreen()">C</button>
        <button class="operator" onclick="appendValue('/')">/</button>
        <button class="operator" onclick="appendValue('*')">×</button>
        
        <button onclick="appendValue('7')">7</button>
        <button onclick="appendValue('8')">8</button>
        <button onclick="appendValue('9')">9</button>
        <button class="operator" onclick="appendValue('-')">-</button>
        
        <button onclick="appendValue('4')">4</button>
        <button onclick="appendValue('5')">5</button>
        <button onclick="appendValue('6')">6</button>
        <button class="operator" onclick="appendValue('+')">+</button>
        
        <button onclick="appendValue('1')">1</button>
        <button onclick="appendValue('2')">2</button>
        <button onclick="appendValue('3')">3</button>
        <button class="equal" onclick="calculate()">=</button>
        
        <button onclick="appendValue('0')" style="grid-column: span 2;">0</button>
        <button onclick="appendValue('.')">.</button>
    </div>
</div>

<script>
    const resultInput = document.getElementById('result');

    function appendValue(value) {
        if (resultInput.value === '0' && value !== '.') {
            resultInput.value = value;
        } else {
            resultInput.value += value;
        }
    }

    function clearScreen() {
        resultInput.value = '0';
    }

    function calculate() {
        try {
            // Evaluates the string expression securely inside the input window
            resultInput.value = eval(resultInput.value);
        } catch (error) {
            resultInput.value = 'Error';
        }
    }
</script>

</body>
</html>