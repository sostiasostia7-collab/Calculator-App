<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mary Joy Sostia - Portfolio</title>
  <style>
    /* Reset & Base Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: #f4f7f6;
      color: #333;
      line-height: 1.6;
      padding: 20px;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      background: #ffffff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    /* Header Section */
    header {
      border-bottom: 2px solid #eaeaea;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }

    h1 {
      font-size: 2.2rem;
      color: #1e293b;
      margin-bottom: 5px;
    }

    .subtitle {
      font-size: 1.1rem;
      color: #64748b;
      font-weight: 500;
    }

    /* Section Titles */
    h2 {
      font-size: 1.5rem;
      color: #0f172a;
      margin-bottom: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Projects Grid */
    .projects-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 35px;
    }

    @media (min-width: 600px) {
      .projects-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 12px rgba(0, 0, 0, 0.08);
    }

    .card h3 {
      font-size: 1.2rem;
      color: #1e293b;
      margin-bottom: 10px;
    }

    .card p {
      color: #475569;
      font-size: 0.95rem;
    }

    /* Contact & Details Section */
    .contact-info {
      background-color: #f8fafc;
      padding: 20px;
      border-radius: 8px;
      border-left: 4px solid #2563eb;
    }

    .contact-item {
      margin-bottom: 10px;
      font-size: 1rem;
    }

    .contact-item:last-child {
      margin-bottom: 0;
    }

    .contact-item strong {
      color: #334155;
    }

    .contact-item a {
      color: #2563eb;
      text-decoration: none;
    }

    .contact-item a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>

  <div class="container">
    <!-- Header Section -->
    <header>
      <h1>I'm Mary joy Sostia</h1>
      <p class="subtitle">IT student | BSIT Student</p>
    </header>

    <!-- Projects Section -->
<section>
  <h2>📁 My Projects</h2>
  <div class="projects-grid">
    
    <div class="card">
      <h3>Calculator App</h3>
      <p>A simple calculator built with HTML.</p>
    </div>

    <div class="card">
      <h3>Portfolio Website</h3>
      <p>My first portfolio website using HTML.</p>
    </div>

    <div class="card">
      <h3>GitHub Account Creation</h3>
      <p>Created and configured my professional GitHub account to showcase my web development projects and code repositories.</p>
    </div>
    

  </div>
</section>


    <!-- Contact & Information Section -->
    <section class="contact-info">
      <h2>📫 Contact</h2>
      
      <div class="contact-item">
        <strong>Email:</strong> 
        <a href="mailto:sostiasostia7@gmail.com">sostiasostia7@gmail.com</a>
      </div>

      <div class="contact-item">
        <strong>GitHub:</strong> 
        <a href="https://github.com/sostiasostia7-collab" target="_blank">github.com/sostiasostia7-collab</a>
      </div>

      <div class="contact-item">
        <strong>Course:</strong> BSIT 1C
      </div>
    </section>
  </div>

</body>
</html>
